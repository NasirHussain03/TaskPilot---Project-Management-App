# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/projectmanagement
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/projectmanagement
MONGO_URI=mongodb://127.0.0.1:27017/projectmanagement

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_key_here

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed client origins
# Production example: https://taskpilot-client.up.railway.app
CLIENT_URL=http://localhost:3000
